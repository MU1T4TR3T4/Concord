{
  "name": "concord",
  "productName": "Concord",
  "version": "0.1.0",
  "description": "Voz, salas e transmissão de tela entre amigos",
  "author": "Concord",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@types/node": "^26.6.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.concord.desktop",
    "productName": "Concord",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Concord-Setup-${version}.exe"
    }
  }
}
