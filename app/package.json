{
  "name": "concord",
  "productName": "Concord",
  "version": "0.3.3",
  "description": "Voz, salas e transmissão de tela entre amigos",
  "author": "Concord",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts --mode web",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/make-icon.cjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.concord.desktop",
    "productName": "Concord",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Concord-Setup-${version}.exe",
      "shortcutName": "Concord"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MU1T4TR3T4",
        "repo": "Concord",
        "releaseType": "release"
      }
    ]
  }
}
